<div id="interaction-panel-container" style="position: fixed; inset: auto 20px 20px auto; width: 100px; height: 100px; z-index: 999999;"><template shadowrootmode="open"><style>/* Shadow DOM 样式重置 - 阻止外部样式继承 */
:host {
    /* 重置所有可继承的属性 */
    all: initial;
    
    /* 保持必要的显示属性 */
    display: block;
    
    /* 恢复重要的继承属性，避免影响内部样式 */
    font-size: inherit;      /* 避免影响内部的 px/em/rem 计算 */
    line-height: 1.6;    /* 避免影响内部的行高设置 */
    color: inherit;          /* 避免影响 currentColor 和 SVG fill */
    direction: inherit;      /* 保持文本方向一致性 */
    font-weight: inherit;    /* 避免影响 bolder/lighter 相对值 */
    letter-spacing: inherit; /* 保持字母间距的基准 */
    /* 注意：不恢复 white-space、word-break 等，因为这些正是我们要防止的 */
}

/* 在 Shadow DOM 根级别重置所有可继承的文本相关属性 */
:host * {
    /* 文本相关 */
    /* 继承以下字体属性 */
    /* font: inherit; */  /* 注释掉，让它继承 */
    /* font-family: inherit; */  /* 继承宿主页面的字体 */
    /* font-style: inherit; */  /* 继承斜体设置 */
    /* font-variant: inherit; */  /* 继承小型大写字母设置 */
    
    /* 重置其他字体属性 */
    font-size-adjust: initial;
    font-stretch: initial;
    
    /* 空白和换行 */
    white-space: normal;
    word-break: normal;
    word-wrap: normal;
    word-spacing: normal;
    
    /* 行高和对齐 */
    text-align: initial;
    text-indent: initial;
    text-transform: initial;
    
    text-decoration: initial;
    text-shadow: initial;
    unicode-bidi: initial;
    vertical-align: initial;
    
    /* 列表 */
    list-style: initial;
    
    /* 表格 */
    border-collapse: initial;
    border-spacing: initial;
    caption-side: initial;
    empty-cells: initial;
    table-layout: initial;
    
    /* 其他可继承属性 */
    /* cursor: initial;
    quotes: initial;
    orphans: initial;
    widows: initial;
    tab-size: initial;
    hyphens: initial; */
    
    /* 确保盒模型正常 */
    box-sizing: border-box;
}

/* 为面板根元素设置基础样式 */
.cvmax-ext-qasvo-interaction-panel {
    /* 确保这些属性不被继承覆盖 */
    white-space: normal;
    word-break: normal;
    word-wrap: normal;
    line-height: 1.5;
}
/* 摇动动画 */
@keyframes cvmax-ext-qasvo-shake {
    0%, 100% {
        transform: translateX(0);
    }
    10%, 30%, 50%, 70%, 90% {
        transform: translateX(-2px);
    }
    20%, 40%, 60%, 80% {
        transform: translateX(2px);
    }
}

/* 精致层次加载动画 */

/* 主旋转动画 */
@keyframes cvmax-ext-qasvo-rotate {
    0% {
        transform: rotate(0deg);
    }
    100% {
        transform: rotate(360deg);
    }
}

/* 呼吸动画 - 仅使用opacity避免transform冲突 */
@keyframes cvmax-ext-qasvo-breathe {
    0%, 100% {
        opacity: 0.9;
    }
    50% {
        opacity: 1;
    }
}

/* 渐显动画 */
@keyframes cvmax-ext-qasvo-fade-in {
    0% {
        opacity: 0;
    }
    100% {
        opacity: 1;
    }
}

/* 脉冲动画 */
@keyframes cvmax-ext-qasvo-pulse {
    0% {
        transform: scale(1);
        opacity: 1;
    }
    50% {
        transform: scale(1.8);
        opacity: 0;
    }
    100% {
        transform: scale(1);
        opacity: 0;
    }
}

/* 加载动画容器 */
.cvmax-ext-qasvo-loading-section {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    min-height: 400px;
    padding: 40px 0;
    box-sizing: border-box;
    background: linear-gradient(135deg, #F8F9FB 0%, #FAFBFC 100%);
    border-radius: 12px;
    position: relative;
}

.cvmax-ext-qasvo-loading-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 28px;
    animation: cvmax-ext-qasvo-fade-in 0.8s ease-out;
}

/* 主加载动画容器 */
.cvmax-ext-qasvo-loading-spinner {
    position: relative;
    width: 120px;
    height: 120px;
}

/* 底层圆环 */
.cvmax-ext-qasvo-loading-spinner::before {
    content: '';
    position: absolute;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    border: 2px solid #E8E8ED;
}

/* 主进度圆弧 */
.cvmax-ext-qasvo-loading-spinner::after {
    content: '';
    position: absolute;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    border: 2px solid transparent;
    border-top-color: #6B4EFF;
    border-right-color: #6B4EFF;
    animation: cvmax-ext-qasvo-rotate 1.5s cubic-bezier(0.68, -0.55, 0.265, 1.55) infinite;
}

/* 中心品牌圆容器 - 仅负责定位 */
.cvmax-ext-qasvo-loading-core {
    position: absolute;
    top: 52%;
    left: 52%;
    transform: translate(-50%, -50%);
    width: 48px;
    height: 48px;
}

/* 品牌圆内容 - 使用伪元素承载所有样式和动画 */
.cvmax-ext-qasvo-loading-core::after {
    content: 'CVMax';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    background: linear-gradient(135deg, #6B4EFF 0%, #8B5CF6 100%);
    box-shadow: 0 2px 12px rgba(107, 78, 255, 0.3);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 10px;
    font-weight: 600;
    color: white;
    letter-spacing: 0.2px;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    text-transform: uppercase;
    animation: cvmax-ext-qasvo-breathe 2s ease-in-out infinite;
}

/* 脉冲波纹 */
.cvmax-ext-qasvo-loading-core::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    background: #6B4EFF;
    animation: cvmax-ext-qasvo-pulse 2s ease-out infinite;
    z-index: -1;
}

/* 删除不需要的元素 */
.cvmax-ext-qasvo-loading-particles,
.cvmax-ext-qasvo-loading-halo,
.cvmax-ext-qasvo-particle {
    display: none;
}

/* 加载文字 */
.cvmax-ext-qasvo-loading-text {
    font-size: 14px;
    color: #666;
    font-weight: 400;
    margin: 0;
    text-align: center;
    letter-spacing: 0.2px;
}

/* 交互面板样式 */
.cvmax-ext-qasvo-interaction-panel {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: #FFFFFF;
    border-radius: 16px;
    border-bottom-right-radius: 27px;
    border-bottom-left-radius: 27px;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.12);
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'PingFang SC', 'Microsoft YaHei', sans-serif;
    z-index: 999999 !important;
    overflow: hidden;
    transition: all 0.3s ease;
    visibility: visible;
    display: flex;
    flex-direction: column;
    opacity: 1;
}

/* 拖拽时的样式 */
.cvmax-ext-qasvo-interaction-panel.cvmax-ext-qasvo-dragging {
    transition: none !important;
    z-index: 9999999 !important;
    cursor: move !important;
    user-select: none;
    box-shadow: 0 15px 50px rgba(0, 0, 0, 0.2);
}

/* 面板头部 */
.cvmax-ext-qasvo-panel-header {
    background: linear-gradient(135deg, #E8E5FF 0%, #F5F3FF 100%);
    padding: 4px;
    border-bottom: 1px solid rgba(0, 0, 0, 0.05);
    flex-shrink: 0; /* 头部不收缩 */
    border-radius: 16px 16px 0 0; /* 只有顶部圆角 */
    position: relative;
    cursor: move;
    user-select: none;
    z-index: 10; /* 确保header及其子元素在banner之上 */
}

/* 动态Header内容样式 */
.cvmax-ext-qasvo-header-content {
    padding: 12px 16px;
    display: flex;
    align-items: center;
    position: relative;
    pointer-events: none; /* 禁用header内容的点击事件，避免干扰按钮 */
}

.cvmax-ext-qasvo-tab-header {
    display: none;
    align-items: center;
    gap: 12px;
    width: 100%;
}

.cvmax-ext-qasvo-tab-header.cvmax-ext-qasvo-active {
    display: flex;
    margin: auto;
    margin-right: 40px;
}

.cvmax-ext-qasvo-header-icon {
    font-size: 24px;
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(255, 255, 255, 0.2);
    border-radius: 8px;
}

.cvmax-ext-qasvo-header-title {
    font-size: 16px;
    font-weight: 600;
    color: #1A1A1A;
    flex: 1;
    max-width: 200px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}
/* 配额信息样式 */
.cvmax-ext-qasvo-quota-info {
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 4px;
    padding-bottom: 4px;
    background: white;
    border-radius: 6px;
    outline: 1px #ECE9FF solid;
    outline-offset: -1px;
    justify-content: center;
    align-items: center;
    margin-left: 10px;
    position: relative;
    cursor: pointer;
    pointer-events: auto !important; /* 确保可以接收鼠标事件 */
    z-index: 10; /* 确保在其他元素之上 */
}
.cvmax-ext-qasvo-quota-text {
    color: #666666;
    font-size: 10px;
    font-family: PingFang SC;
    font-weight: 400;
    line-height: 10px;
    white-space: nowrap;
}
/* Tooltip样式 */
.cvmax-ext-qasvo-quota-tooltip {
    position: absolute;
    top: 100%;
    right: 0;
    margin-top: 8px;
    background: white;
    border-radius: 8px;
    box-shadow: 0px 4px 12px rgba(0, 0, 0, 0.15);
    padding: 12px;
    min-width: 200px;
    display: none;
    z-index: 999999; /* 提高z-index确保在banner之上 */
}
.cvmax-ext-qasvo-quota-tooltip::before {
    content: '';
    position: absolute;
    bottom: 100%;
    right: 20px;
    width: 0;
    height: 0;
    border-left: 6px solid transparent;
    border-right: 6px solid transparent;
    border-bottom: 6px solid white;
}
.cvmax-ext-qasvo-tooltip-content {
    display: flex;
    flex-direction: column;
    gap: 8px;
}
.cvmax-ext-qasvo-tooltip-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 12px;
    line-height: 16px;
}
.cvmax-ext-qasvo-tooltip-label {
    color: #666666;
    font-family: PingFang SC;
}
.cvmax-ext-qasvo-tooltip-value {
    color: #666666;
    font-family: PingFang SC;
    font-weight: 500;
}
/* 鼠标悬停时显示tooltip */
.cvmax-ext-qasvo-quota-info:hover .cvmax-ext-qasvo-quota-tooltip {
    display: block;
}

.cvmax-ext-qasvo-header-icon-img {
    /* 图片缩放到32px */
    width: 48px;
    height: 48px;
    object-fit: contain;
}
/* 折叠状态下隐藏header内容 */
.cvmax-ext-qasvo-panel-collapsed .cvmax-ext-qasvo-header-content {
    display: none;
}

.cvmax-ext-qasvo-user-avatar {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: transparent;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 24px;
}



/* 面板主体 */
.cvmax-ext-qasvo-panel-body {
    /* padding: 16px; */
    flex: 1; /* 占用剩余空间 */
    overflow-y: auto; /* 纵向滚动 */
    overflow-x: hidden; /* 隐藏横向滚动 */
    min-height: 0; /* 允许flexbox收缩 */
    scrollbar-width: thin; /* Firefox滚动条 */
    scrollbar-color: #D0D0D0 transparent; /* Firefox滚动条颜色 */
    position: relative; /* 为tab内容定位提供参考 */
}

/* Tab内容样式 */
.cvmax-ext-qasvo-tab-content {
    position: absolute;
    padding: 16px;
    top: 0;
    left: 20px;
    right: 20px;
    bottom: 0;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.2s ease, visibility 0.2s ease;
    display: flex;
    flex-direction: column;
    overflow-y: auto;
    overflow-x: hidden;
}

.cvmax-ext-qasvo-tab-content.cvmax-ext-qasvo-active {
    opacity: 1;
    visibility: visible;
    position: relative;
    left: 0;
    right: 0;
}

/* 自定义滚动条样式 - WebKit */
.cvmax-ext-qasvo-panel-body::-webkit-scrollbar {
    width: 6px;
}

.cvmax-ext-qasvo-panel-body::-webkit-scrollbar-track {
    background: transparent;
}

.cvmax-ext-qasvo-panel-body::-webkit-scrollbar-thumb {
    background: #D0D0D0;
    border-radius: 3px;
    transition: background 0.2s ease;
}

.cvmax-ext-qasvo-panel-body::-webkit-scrollbar-thumb:hover {
    background: #B0B0B0;
}

/* 消息流容器 */
.cvmax-ext-qasvo-message-container {
    padding-top: 38px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding-bottom: 42px;
    min-height: 440px;
}

/* 消息基础样式 */
.cvmax-ext-qasvo-message {
    display: flex;
    flex-direction: column;
    width: 100%;
}

.cvmax-ext-qasvo-message-content {
    font-size: 14px;
    line-height: 1.6;
}

/* 正在输入指示器样式 */
.cvmax-ext-qasvo-typing-indicator::after {
    content: '...';
    display: inline-block;
    animation: cvmax-ext-qasvo-typing 1.5s infinite;
}

@keyframes cvmax-ext-qasvo-typing {
    0%, 20% { content: '.'; }
    40% { content: '..'; }
    60%, 100% { content: '...'; }
}


.cvmax-ext-qasvo-notification-message {
    display: flex;
    justify-content: center;
}

.cvmax-ext-qasvo-notification-message .cvmax-ext-qasvo-message-content {
    color: #999;
    font-size: 12px;
    padding: 4px 12px;
    /* text-align: center !important; */
    align-items: center !important; 
    justify-content: center !important;
    font-weight: 400;
    line-height: 1.0;
    display: inline-block;
    white-space: nowrap;
}

.cvmax-ext-qasvo-notification-message .cvmax-ext-qasvo-message-text {
    display: inline-flex;
    align-items: center;
    gap: 6px;
}

.cvmax-ext-qasvo-notification-message .cvmax-ext-qasvo-message-text::before {
    content: "";
    display: inline-block;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: #46d680;
    flex-shrink: 0;
    margin-top: 2px;
}


.cvmax-ext-qasvo-notification-loading .cvmax-ext-qasvo-message-text::before {
    animation: cvmax-ext-qasvo-notification-blink 1.5s ease-in-out infinite;
}

@keyframes cvmax-ext-qasvo-notification-blink {
    0% {
        opacity: 0.25;
    }
    30% {
        opacity: 1;
    }
    70% {
        opacity: 1;
    }
    100% {
        opacity: 0.25;
    }
}

/* 系统消息样式 - 按照Figma设计 */
.cvmax-ext-qasvo-system-message .cvmax-ext-qasvo-message-content {
    /* background: #F6F6FA; */
    background: #F6F6FA;
    color: rgba(0, 0, 0, 0.85);
    padding: 4px 12px;
    border-radius: 12px;
    box-sizing: border-box;
    max-width: 320px;
    padding: 12px;
    text-align: center
}

/* 用户消息样式 - 右对齐气泡 */
.cvmax-ext-qasvo-user-message .cvmax-ext-qasvo-message-content {
    background: #6B4EFF;
    color: white;
    padding: 12px 16px;
    border-radius: 18px;
    align-self: flex-end;
    max-width: 80%;
    border-radius: 12px;
}

/* 操作消息样式（包含交互元素） */
.cvmax-ext-qasvo-action-message .cvmax-ext-qasvo-message-content {
    background: transparent;
    padding: 0;
    width: 100%;
}

/* 时间戳消息样式 - 仿微信样式 */
.cvmax-ext-qasvo-timestamp-message {
    display: flex;
    justify-content: center;
    /* margin: 12px 0 8px 0; */
}

.cvmax-ext-qasvo-timestamp-message .cvmax-ext-qasvo-message-content {
    /* background: rgba(0, 0, 0, 0.05); */
    color: #999;
    font-size: 12px;
    padding: 4px 12px;
    border-radius: 12px;
    text-align: center;
    font-weight: 400;
    line-height: 1.2;
    display: inline-block;
    white-space: nowrap;
}

/* 消息文本 */
.cvmax-ext-qasvo-message-text {
    margin: 0;
    word-wrap: break-word;
}

/* 消息时间 */
.cvmax-ext-qasvo-message-time {
    font-size: 11px;
    color: #999;
    margin-top: 4px;
    text-align: right;
}

/* 输入区域 */
.cvmax-ext-qasvo-input-area {
    flex-shrink: 0; /* 输入区域不收缩 */
    background: #FFFFFF;
    border-top: 1px solid rgba(0, 0, 0, 0.05);
    padding: 16px 20px;
}

/* 建议按钮区域 - 在输入框上方 */
.cvmax-ext-qasvo-suggest-buttons {
    display: flex;
    justify-content: center;
    margin-bottom: 12px;
    gap: 8px;
}

.cvmax-ext-qasvo-suggest-button {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 20px;
    /* background: linear-gradient(135deg, #6B4EFF 0%, #8B5CF6 100%); */
    background: yellow;
    color: white;
    border: none;
    border-radius: 20px; /* 更圆润的建议按钮 */
    font-size: 13px;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.2s ease;
    box-shadow: 0 2px 8px rgba(107, 78, 255, 0.2);
}

.cvmax-ext-qasvo-suggest-button:hover {
    /* background: linear-gradient(135deg, #5A3FE6 0%, #7C3AED 100%); */
    background: green;
    box-shadow: 0 4px 12px rgba(107, 78, 255, 0.3);
    transform: translateY(-1px);
}

.cvmax-ext-qasvo-suggest-button:active {
    transform: translateY(0);
    box-shadow: 0 1px 4px rgba(107, 78, 255, 0.2);
}

.cvmax-ext-qasvo-button-icon {
    font-size: 14px;
}

.cvmax-ext-qasvo-button-text {
    font-family: 'PingFang SC', -apple-system, BlinkMacSystemFont, sans-serif;
}

/* 输入框容器 */
.cvmax-ext-qasvo-input-container {
    display: flex;
    align-items: center;
    gap: 8px;
    background: #F8F9FA;
    border-radius: 20px;
    padding: 8px 12px;
}

.cvmax-ext-qasvo-input-container input {
    flex: 1;
    border: none;
    background: transparent;
    outline: none;
    font-size: 14px;
    padding: 4px 8px;
}

.cvmax-ext-qasvo-input-container button {
    background: #6B4EFF;
    color: white;
    border: none;
    border-radius: 16px;
    padding: 6px 12px;
    font-size: 12px;
    cursor: pointer;
}

/* 邀请分享 Banner - 视觉浮层效果 */
.cvmax-ext-qasvo-invite-banner {
    width: 100%;
    height: 40px;
    background: #FFEFC4;
    position: absolute;
    top: 64px;
    left: 0;
    right: 0;
    z-index: 5; /* 在内容上方但在 header 下方 */
    display: none; /* 默认隐藏 */
    opacity: 0;
    visibility: hidden;
}

/* 当 invite-banner 显示时的样式 */
.cvmax-ext-qasvo-invite-banner.cvmax-ext-qasvo-active {
    display: block;
    opacity: 1;
    visibility: visible;
}

.cvmax-ext-qasvo-invite-banner-content {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 14px; /* 内容的实际边距 */
}

.cvmax-ext-qasvo-invite-text {
    width: 260px;
    color: rgba(0, 0, 0, 0.85);
    font-size: 13px;
    font-family: PingFang SC, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    font-weight: 400;
    white-space: nowrap; /* 强制单行显示 */
    flex: 1; /* 占满剩余空间 */
    overflow: hidden; /* 隐藏超出部分 */
    margin-left: 8px; /* 与图标的间距 */
    position: relative; /* 为内部滚动文本定位 */
}

/* 需要滚动的文本 */
.cvmax-ext-qasvo-invite-text-scroll {
    display: inline-block;
    white-space: nowrap; /* 确保文本在一行 */
    animation: cvmax-ext-qasvo-scroll-text 40s linear infinite;
}

/* 文本滚动动画 */
@keyframes cvmax-ext-qasvo-scroll-text {
    0% {
        transform: translateX(10%);
    }
    100% {
        transform: translateX(-80%);
    }
}


.cvmax-ext-qasvo-share-button {
    padding: 4px 8px;
    background: black;
    border-radius: 8px;
    border: none;
    color: white;
    font-size: 12px;
    font-family: Alibaba PuHuiTi 3.0, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    font-weight: 500;
    line-height: 12px;
    cursor: pointer;
    transition: all 0.2s ease;
    white-space: nowrap;
}

.cvmax-ext-qasvo-share-button:hover {
    background: #333;
    transform: translateY(-1px);
}

.cvmax-ext-qasvo-share-button:active {
    transform: translateY(0);
}

/* 简历选择区域 - 作为消息的一部分 */
.cvmax-ext-qasvo-resume-section {
    margin-bottom: 12px; /* 减少底部边距，因为有时间戳 */
}

/* 简历选项样式 - 严格按照Figma设计 */
.cvmax-ext-qasvo-resume-option {
    position: relative;
    box-sizing: border-box;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px 12px;
    margin-bottom: 12px;
    width: 320px;
    height: 56px;
    border-radius: 12px;
    cursor: pointer;
    transition: all 0.2s ease;
}


.cvmax-ext-qasvo-resume-selected {
    box-sizing: border-box;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px;
    margin-bottom: 12px;
    width: 320px;
    height: 56px;
    border-radius: 12px;
    cursor: pointer;
    transition: all 0.2s ease;
    background: #ECE9FF;
    border-color: #D0C7FF;
}

/* 未选中状态 - 按照Figma */
.cvmax-ext-qasvo-resume-option:not(.cvmax-ext-qasvo-selected) {
    background: #FFFFFF;
    border: 1px solid #ECE9FF;
}

.cvmax-ext-qasvo-resume-option:not(.cvmax-ext-qasvo-selected):hover {
    background: #FAFAFA;
    border-color: #D0C7FF;
}

/* 选中状态 - 按照Figma */
.cvmax-ext-qasvo-resume-option.cvmax-ext-qasvo-selected {
    background: #ECE9FF;
    border: 1px solid rgba(242, 242, 242, 0.623529);
}

.cvmax-ext-qasvo-resume-content {
    display: flex;
    align-items: center;
    gap: 12px;
    flex: 1;
    min-width: 0;
}

/* 文档图标样式 - 按照Figma */
.cvmax-ext-qasvo-resume-icon {
    width: 32px;
    height: 32px;
    border-radius: 14.6667px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 16px;
    transition: all 0.2s ease;
    /* Figma渐变背景 */
    background: linear-gradient(180deg, #E3D4FD 0%, #F1E9FF 100%);
    color: #FFFFFF;
}

.cvmax-ext-qasvo-resume-name {
    font-family: 'PingFang SC';
    font-weight: 500;
    font-size: 12px;
    line-height: 20px;
    color: rgba(0, 0, 0, 0.85);
    transition: color 0.2s ease;
    flex: 1;
    overflow: hidden;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
}

/* 简历操作区域容器 */
.cvmax-ext-qasvo-resume-actions {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-shrink: 0;
}

/* 预览按钮样式 */
.cvmax-ext-qasvo-resume-preview-btn {
    width: 32px;
    height: 32px;
    border: none;
    background: transparent;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.2s ease;
    position: relative;
    flex-shrink: 0;
    border-radius: 6px;
    padding: 0;
}

.cvmax-ext-qasvo-resume-preview-btn:hover {
    background: rgba(139, 92, 246, 0.08);
}

.cvmax-ext-qasvo-resume-preview-btn svg path {
    fill: #6B4EFF;
}

.cvmax-ext-qasvo-resume-preview-btn:active {
    transform: scale(0.95);
}

/* Tooltip样式 */
.cvmax-ext-qasvo-resume-preview-btn::after {
    content: attr(title);
    position: absolute;
    bottom: 100%;
    left: 50%;
    transform: translateX(-50%);
    margin-bottom: 6px;
    padding: 4px 8px;
    background: rgba(0, 0, 0, 0.8);
    color: white;
    font-size: 12px;
    border-radius: 4px;
    white-space: nowrap;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s ease;
    z-index: 1000;
}

.cvmax-ext-qasvo-resume-preview-btn:hover::after {
    opacity: 1;
}

/* 复选框容器 - 按照Figma */
.cvmax-ext-qasvo-resume-checkbox {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    padding: 4px;
    width: 32px;
    height: 32px;
}

/* 复选框圆圈 - 按照Figma */
.cvmax-ext-qasvo-checkbox-circle {
    width: 18px;
    height: 18px;
    border-radius: 9px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s ease;
    border: none;
}

/* 未选中状态的复选框 - 按照Figma */
.cvmax-ext-qasvo-resume-option:not(.cvmax-ext-qasvo-selected) .cvmax-ext-qasvo-checkbox-circle {
    background: #D9D9D9;
}

/* 选中状态的复选框 - 按照Figma */
.cvmax-ext-qasvo-resume-option.cvmax-ext-qasvo-selected .cvmax-ext-qasvo-checkbox-circle {
    background: #6A2AFF;
}

.cvmax-ext-qasvo-resume-option.cvmax-ext-qasvo-selected .cvmax-ext-qasvo-checkbox-circle.cvmax-ext-qasvo-checked {
    background: #6A2AFF;
}

.cvmax-ext-qasvo-resume-selected .cvmax-ext-qasvo-checkbox-circle {
    background: #6A2AFF;
}

.cvmax-ext-qasvo-resume-selected .cvmax-ext-qasvo-checkbox-circle.cvmax-ext-qasvo-checked {
    background: #6A2AFF;
}

/* 锁定状态 - 点击时显示抖动效果 */
.cvmax-ext-qasvo-resume-option.cvmax-ext-qasvo-locked {
    cursor: not-allowed;
    opacity: 0.8;
}

.cvmax-ext-qasvo-resume-option.cvmax-ext-qasvo-locked:active {
    animation: cvmax-ext-qasvo-shake 0.3s ease-in-out;
}

/* 简历评分模块 */
.cvmax-ext-qasvo-resume-score {
    position: absolute;
    width: 104px;
    height: 24px;
    right: 0px;
    top: -12px;
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom-left-radius: 0px;
    border-bottom-right-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 12px;
    font-weight: 400;
    color: white;
    cursor: help;
}

.cvmax-ext-qasvo-resume-score-text {
    white-space: nowrap;
}

/* 不同分数的颜色 */
.cvmax-ext-qasvo-score-red {
    background: linear-gradient(90deg, #FF7C6C 0%, #FF422B 100%);
}

.cvmax-ext-qasvo-score-yellow {
    background: linear-gradient(90deg, #FFC42E 0%, #F9B300 100%);
}

.cvmax-ext-qasvo-score-green {
    background: linear-gradient(90deg, #7CE275 0%, #60D757 100%);
}

/* 评分Tooltip */
.cvmax-ext-qasvo-resume-score-tooltip {
    position: absolute;
    top: 100%;
    right: 0;
    margin-top: 8px;
    background: white;
    border-radius: 8px;
    box-shadow: 0px 4px 12px rgba(0, 0, 0, 0.15);
    padding: 12px;
    min-width: 180px;
    display: none;
    z-index: 999999;
}

.cvmax-ext-qasvo-resume-score-tooltip::before {
    content: '';
    position: absolute;
    bottom: 100%;
    right: 20px;
    width: 0;
    height: 0;
    border-left: 6px solid transparent;
    border-right: 6px solid transparent;
    border-bottom: 6px solid white;
}

.cvmax-ext-qasvo-resume-score:hover .cvmax-ext-qasvo-resume-score-tooltip {
    display: block;
}

/* 旧的简历项样式（保留兼容性） */
.cvmax-ext-qasvo-resume-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px;
    margin-bottom: 12px;
    background: #F8F9FA;
    border-radius: 12px;
    cursor: pointer;
    transition: all 0.2s ease;
    border: 2px solid transparent;
}

.cvmax-ext-qasvo-resume-item:hover {
    background: #F0F2F5;
}

.cvmax-ext-qasvo-resume-item.cvmax-ext-qasvo-selected {
    background: #E8E5FF;
    border-color: #6B4EFF;
}

.cvmax-ext-qasvo-resume-info {
    display: flex;
    align-items: center;
    gap: 12px;
}

.cvmax-ext-qasvo-resume-check {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: #6B4EFF;
    color: white;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 14px;
    opacity: 0;
    transition: opacity 0.2s ease;
}

.cvmax-ext-qasvo-resume-item.cvmax-ext-qasvo-selected .cvmax-ext-qasvo-resume-check {
    opacity: 1;
}

.cvmax-ext-qasvo-resume-item:not(.cvmax-ext-qasvo-selected) .cvmax-ext-qasvo-resume-check {
    background: #E0E0E0;
}


/* 底部状态栏 - 根据设计稿重新设计 */
.cvmax-ext-qasvo-panel-footer {
    flex-shrink: 0;
    padding: 0;
    background: transparent;
    border: none;
}

/* Progress info - 保留但隐藏，暂时不用 */
.cvmax-ext-qasvo-progress-info {
    display: none;
}

.cvmax-ext-qasvo-progress-status {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    color: #666;
}

.cvmax-ext-qasvo-status-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #4CAF50;
    animation: cvmax-ext-qasvo-pulse 2s infinite;
}

@keyframes cvmax-ext-qasvo-pulse {
    0% { opacity: 1; }
    50% { opacity: 0.5; }
    100% { opacity: 1; }
}

.cvmax-ext-qasvo-progress-steps {
    margin-left: auto;
    font-size: 14px;
    color: #999;
}

/* Login tab footer样式 */
.cvmax-ext-qasvo-tab-footer-login {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 12px 16px;
    width: 100%;
    box-sizing: border-box;
}

.cvmax-ext-qasvo-login-footer-info {
    width: 100%;
    text-align: center;
    font-family: 'PingFang SC', -apple-system, BlinkMacSystemFont, sans-serif;
    font-weight: 400;
    font-size: 14px;
    line-height: 20px;
    color: rgba(0, 0, 0, 0.6);
}

.cvmax-ext-qasvo-login-footer-info p {
    /* margin: 0; */
    text-align: center;
}

/* Tab Footer - 新设计的灰色背景容器 */
.cvmax-ext-qasvo-tab-footer-autofill {
    width: 100%;
    height: 54px;
    background: #F6F6FA;
    box-shadow: 0px 4px 30px rgba(0, 0, 0, 0.08);
    border-radius: 27px;
    border: 1px solid transparent;
    margin: 0 auto;
    position: relative;
    display: flex;
    align-items: center;
    padding: 0;
    box-sizing: border-box;
    transition: all 0.2s ease;
    border-color: #6A2AFF;
    box-shadow: 0px 4px 30px rgba(0, 0, 0, 0.08), 0 0 0 2px rgba(106, 42, 255, 0.1);
}

.cvmax-ext-qasvo-tab-footer-login {
    width: 100%;
    height: 54px;
    background: white;
    margin: 0 auto;
    position: relative;
    display: flex;
    align-items: center;
    padding: 0;
}

/* 输入框获得焦点时，容器显示紫色边框 */
.cvmax-ext-qasvo-tab-footer:focus-within {
    border-color: #6A2AFF;
    box-shadow: 0px 4px 30px rgba(0, 0, 0, 0.08), 0 0 0 2px rgba(106, 42, 255, 0.1);
}

/* 建议按钮浮层样式 */
.cvmax-ext-qasvo-suggestion-overlay {
    position: absolute;
    bottom: 100%;
    left: 0;
    right: 0;
    /* margin-bottom: 12px; */
    z-index: 10;
    animation: cvmax-ext-qasvo-slideUpFade 0.3s ease-out;
}

.cvmax-ext-qasvo-suggestion-buttons-container {
    display: flex;
    flex-direction: row;
    gap: 8px;
    padding: 12px;
    /* background: rgba(255, 255, 255, 0.95); */
    /* backdrop-filter: blur(10px); */
    /* border-radius: 16px; */
    /* box-shadow: 0 8px 32px rgba(0, 0, 0, 0.12); */
    /* border: 1px solid rgba(255, 255, 255, 0.2); */
    justify-content: flex-end;
    flex-wrap: wrap;
}


.cvmax-ext-qasvo-suggestion-buttons-container .cvmax-ext-qasvo-suggestion-button {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 12px 12px;
    /* background: rgba(232, 222, 255, 0.3); */
    /* background: red; */
    /* background: #ECE9FF; */
    background:#DACAFF;
    color: rgba(0, 0, 0, 0.85);
    border: none;
    border-radius: 12px;
    font-size: 14px;
    font-weight: 400;
    cursor: pointer;
    transition: all 0.2s ease;
    min-height: 44px;
    white-space: nowrap;
}

.cvmax-ext-qasvo-suggestion-buttons-container .cvmax-ext-qasvo-suggestion-button:hover {
    background: #6B4EFF;
    color: white;
}

.cvmax-ext-qasvo-suggestion-buttons-container .cvmax-ext-qasvo-suggestion-button:active {
    transform: translateY(0);
    box-shadow: 0 1px 4px rgba(107, 78, 255, 0.2);
}

.cvmax-ext-qasvo-suggestion-buttons-container .cvmax-ext-qasvo-suggestion-button .cvmax-ext-qasvo-button-icon {
    font-size: 16px;
}

.cvmax-ext-qasvo-suggestion-buttons-container .cvmax-ext-qasvo-suggestion-button .cvmax-ext-qasvo-button-text {
    font-weight: 400;
}

/* Tooltip样式 */
.cvmax-ext-qasvo-suggestion-button.cvmax-ext-qasvo-has-tooltip {
    position: relative;
}

.cvmax-ext-qasvo-suggestion-button.cvmax-ext-qasvo-has-tooltip::after {
    content: attr(data-tooltip);
    position: absolute;
    bottom: 100%;
    left: 50%;
    transform: translateX(-50%);
    margin-bottom: 8px;
    padding: 8px 12px;
    background: rgba(0, 0, 0, 0.85);
    color: white;
    font-size: 12px;
    line-height: 1.4;
    border-radius: 6px;
    white-space: nowrap;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.2s ease, visibility 0.2s ease;
    pointer-events: none;
    z-index: 10000;
    width: max-content;
    max-width: 300px;
}

.cvmax-ext-qasvo-suggestion-button.cvmax-ext-qasvo-has-tooltip::before {
    content: '';
    position: absolute;
    bottom: 100%;
    left: 50%;
    transform: translateX(-50%);
    margin-bottom: 2px;
    border: 4px solid transparent;
    border-top-color: rgba(0, 0, 0, 0.8);
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.2s ease, visibility 0.2s ease;
    pointer-events: none;
    z-index: 1000;
}

/* 右侧按钮的tooltip向左对齐，防止超出边界 */
.cvmax-ext-qasvo-suggestion-buttons-container .cvmax-ext-qasvo-suggestion-button.cvmax-ext-qasvo-has-tooltip:nth-last-child(1)::after,
.cvmax-ext-qasvo-suggestion-buttons-container .cvmax-ext-qasvo-suggestion-button.cvmax-ext-qasvo-has-tooltip:nth-last-child(2)::after {
    left: auto;
    right: 0;
    transform: translateX(0);
}

.cvmax-ext-qasvo-suggestion-buttons-container .cvmax-ext-qasvo-suggestion-button.cvmax-ext-qasvo-has-tooltip:nth-last-child(1)::before,
.cvmax-ext-qasvo-suggestion-buttons-container .cvmax-ext-qasvo-suggestion-button.cvmax-ext-qasvo-has-tooltip:nth-last-child(2)::before {
    left: auto;
    right: 20px;
    transform: translateX(0);
}

.cvmax-ext-qasvo-suggestion-button.cvmax-ext-qasvo-has-tooltip:hover::after,
.cvmax-ext-qasvo-suggestion-button.cvmax-ext-qasvo-has-tooltip:hover::before {
    opacity: 1;
    visibility: visible;
}

/* 浮层动画 */
@keyframes cvmax-ext-qasvo-slideUpFade {
    from {
        opacity: 0;
        transform: translateY(8px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}



/* autofill tab的footer样式 */
#tab-footer-autofill {
    padding: 0;
}

/* 状态浮层 */
.cvmax-ext-qasvo-status-overlay {
    position: absolute;
    bottom: 64px; /* 在输入区域上方 */
    left: 16px;
    right: 0;
    height: 42px;
    width: calc(100% - 40px);
    background: #F6F6FA;
    border-radius: 12px;
    display: flex;
    align-items: center;
    overflow: hidden;
    z-index: 10;
    animation: cvmax-ext-qasvo-slideUpFade 0.3s ease-out;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
}

/* 状态浮层进度背景 */
.cvmax-ext-qasvo-status-overlay::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    height: 100%;
    width: var(--progress-width, 0%);
    background: rgba(155, 122, 255, 0.4);
    transition: width 0.05s linear;
    z-index: 1;
}

/* API等待期间保持简洁的紫色背景 */
.cvmax-ext-qasvo-status-overlay.cvmax-ext-qasvo-api-waiting::before {
    background: rgba(155, 122, 255, 0.4);
}



.cvmax-ext-qasvo-status-content {
    position: relative;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    padding: 0 16px;
    z-index: 2;
}

.cvmax-ext-qasvo-status-text {
    font-family: 'PingFang SC', -apple-system, BlinkMacSystemFont, sans-serif;
    font-style: normal;
    font-weight: 400;
    font-size: 14px;
    line-height: 14px;
    color: rgba(0, 0, 0, 0.85);
    transition: all 0.3s ease;
}

/* 输入区域 */
.cvmax-ext-qasvo-input-section {
    display: flex;
    align-items: center;
    width: 100%;
    height: 100%;
    position: relative;
}

.cvmax-ext-qasvo-input-wrapper {
    position: absolute;
    left: 30px;
    right: 60px;
    top: 50%;
    transform: translateY(-50%);
}

.cvmax-ext-qasvo-input-field {
    width: 100%;
    padding: 0;
    border: none;
    background: transparent;
    font-family: 'PingFang SC', -apple-system, BlinkMacSystemFont, sans-serif;
    font-style: normal;
    font-weight: 400;
    font-size: 16px;
    line-height: 24px;
    color: rgba(0, 0, 0, 0.4);
    outline: none;
    transition: all 0.2s ease;
    text-align: justify;
    caret-color: #6A2AFF;
}

.cvmax-ext-qasvo-input-field::placeholder {
    color: rgba(0, 0, 0, 0.4);
}

.cvmax-ext-qasvo-input-field:focus {
    color: rgba(0, 0, 0, 0.8);
}

.cvmax-ext-qasvo-send-button {
    position: absolute;
    right: 4px;
    top: 50%;
    transform: translateY(-50%);
    width: 46px;
    height: 46px;
    border-radius: 23px;
    background: linear-gradient(293.71deg, rgba(152, 107, 254, 0.755844) 32.09%, rgba(127, 72, 255, 0.72) 71.31%);
    border: none;
    color: white;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.2s ease;
    flex-shrink: 0;
}

.cvmax-ext-qasvo-send-button:hover {
    transform: translateY(-50%) scale(1.05);
}

.cvmax-ext-qasvo-send-button:active {
    transform: translateY(-50%) scale(0.95);
}

.cvmax-ext-qasvo-send-icon {
    width: 20px;
    height: 20px;
}

/* 折叠/展开状态 */
.cvmax-ext-qasvo-panel-collapsed {
    height: 100px;
    width: 100px;
    border-radius: 0;
    overflow: visible;
    cursor: move;
    background: transparent;
    border: none;
    box-shadow: none;
    display: flex;
    flex-direction: row; /* 重置flex方向 */
    align-items: center;
    justify-content: center;
    visibility: visible;
    opacity: 1;
}


.cvmax-ext-qasvo-panel-collapsed .cvmax-ext-qasvo-panel-header,
.cvmax-ext-qasvo-panel-collapsed .cvmax-ext-qasvo-panel-body,
.cvmax-ext-qasvo-panel-collapsed .cvmax-ext-qasvo-panel-footer,
.cvmax-ext-qasvo-panel-collapsed .cvmax-ext-qasvo-invite-banner {
    display: none;
}

/* 最小化图标 */
.cvmax-ext-qasvo-collapsed-icon {
    width: 100px;
    height: 100px;
    display: none;
    cursor: pointer;
    transition: transform 0.2s ease;
    border-radius: 0;
    background: transparent;
    border: none;
    user-select: none;
    pointer-events: auto;
    position: relative;
    z-index: 2147483646;
}

.cvmax-ext-qasvo-panel-collapsed .cvmax-ext-qasvo-collapsed-icon {
    display: block;
}

.cvmax-ext-qasvo-collapsed-icon:hover {
    transform: scale(1.1);
}

/* 注意：拖拽现在由容器统一处理 */

.cvmax-ext-qasvo-panel-header {
    cursor: move;
    user-select: none;
    position: relative;
    z-index: 10; /* 提高z-index确保tooltip在banner之上 */
}

.cvmax-ext-qasvo-collapse-button {
    position: absolute;
    top: 15px;
    right: 12px;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.05);
    border: none;
    cursor: pointer !important; /* 强制使用pointer cursor */
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s ease;
    z-index: 10; /* 确保在header内容之上 */
    pointer-events: auto !important; /* 强制启用点击事件 */
}

.cvmax-ext-qasvo-collapse-button:hover {
    background: rgba(0, 0, 0, 0.1);
}

/* 确保折叠按钮区域不受header拖拽影响 */
.cvmax-ext-qasvo-panel-header .cvmax-ext-qasvo-collapse-button {
    cursor: pointer !important;
    user-select: none;
}

/* 确保登出按钮区域不受header拖拽影响 */
.cvmax-ext-qasvo-panel-header .cvmax-ext-qasvo-logout-button {
    cursor: pointer !important;
    user-select: none;
}

.cvmax-ext-qasvo-logout-button {
    position: absolute;
    top: 15px;
    right: 52px; /* 在折叠按钮左边 */
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.05);
    border: none;
    cursor: pointer !important; /* 强制使用pointer cursor */
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s ease;
    z-index: 10; /* 确保在header内容之上 */
    pointer-events: auto !important; /* 强制启用点击事件 */
}

.cvmax-ext-qasvo-logout-button:hover {
    background: rgba(220, 53, 69, 0.1);
}

.cvmax-ext-qasvo-logout-button:hover svg path {
    stroke: #dc3545;
}

/* 动画效果 */
@keyframes cvmax-ext-qasvo-slideInUp {
    from {
        transform: translateY(100%);
        opacity: 0;
    }
    to {
        transform: translateY(0);
        opacity: 1;
    }
}

.cvmax-ext-qasvo-panel-enter {
    animation: cvmax-ext-qasvo-slideInUp 0.3s ease-out;
}

/* 登录界面样式 */
.cvmax-ext-qasvo-login-content {
    text-align: center;
    padding: 20px 0;
}

.cvmax-ext-qasvo-login-header {
    margin-bottom: 30px;
    text-align: center;
}

.cvmax-ext-qasvo-login-icon {
    font-size: 48px;
    margin-bottom: 16px;
}

.cvmax-ext-qasvo-login-title {
    font-size: 20px;
    font-weight: 600;
    color: #1A1A1A;
    margin: 0 0 8px 0;
}

.cvmax-ext-qasvo-login-subtitle {
    font-size: 14px;
    color: #666;
    margin: 0;
    line-height: 1.5;
}

.cvmax-ext-qasvo-login-status {
    margin: 20px 0;
    padding: 12px;
    border-radius: 8px;
    font-size: 14px;
    line-height: 1.4;
    display: none;
}

.cvmax-ext-qasvo-login-status.cvmax-ext-qasvo-error {
    background: #FFF2F2;
    color: #D32F2F;
    border: 1px solid #FFCDD2;
    display: block;
}

.cvmax-ext-qasvo-login-status.cvmax-ext-qasvo-success {
    background: #F1F8E9;
    color: #388E3C;
    border: 1px solid #C8E6C9;
    display: block;
}

.cvmax-ext-qasvo-login-button {
    width: 100%;
    height: 48px;
    background: #6B4EFF;
    color: white;
    border: none;
    border-radius: 12px;
    font-size: 16px;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.2s ease;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 16px;
}

.cvmax-ext-qasvo-login-button:hover:not(:disabled) {
    background: #5A3FE8;
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(107, 78, 255, 0.3);
}

.cvmax-ext-qasvo-login-button:active:not(:disabled) {
    transform: translateY(0);
}

.cvmax-ext-qasvo-login-button:disabled {
    background: #B0B0B0;
    cursor: not-allowed;
    transform: none;
    box-shadow: none;
}

.cvmax-ext-qasvo-login-btn-text {
    transition: opacity 0.2s ease;
}

.cvmax-ext-qasvo-login-spinner {
    position: absolute;
    display: flex;
    align-items: center;
    justify-content: center;
}

.cvmax-ext-qasvo-spinner {
    width: 20px;
    height: 20px;
    border: 2px solid rgba(255, 255, 255, 0.3);
    border-top: 2px solid white;
    border-radius: 50%;
    animation: cvmax-ext-qasvo-spin 1s linear infinite;
}

/* 二维码加载时的spinner样式 */
.cvmax-ext-qasvo-qr-code-loading .cvmax-ext-qasvo-spinner {
    width: 40px;
    height: 40px;
    border: 3px solid rgba(24, 144, 255, 0.2);
    border-top: 3px solid #1890ff;
}

/* 刷新二维码按钮样式 */
#refresh-qr-button {
    background: #1890ff;
    color: white;
    border: none;
    border-radius: 4px;
    cursor: pointer;
    transition: background 0.3s ease;
}

#refresh-qr-button:hover {
    background: #40a9ff;
}

@keyframes cvmax-ext-qasvo-spin {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
}

.cvmax-ext-qasvo-login-note {
    font-size: 12px;
    color: #999;
    margin: 0;
    line-height: 1.4;
}

/* 用户信息卡片样式 */
.cvmax-ext-qasvo-user-info-section {
    padding: 20px 0;
}

.cvmax-ext-qasvo-user-card {
    background: linear-gradient(135deg, #F8F9FA 0%, #E9ECEF 100%);
    border-radius: 16px;
    padding: 20px;
    margin-bottom: 20px;
    text-align: center;
}

.cvmax-ext-qasvo-user-card .cvmax-ext-qasvo-user-avatar {
    width: 80px;
    height: 80px;
    margin: 0 auto 16px;
    border-radius: 50%;
    overflow: hidden;
    border: 3px solid #6B4EFF;
}

.cvmax-ext-qasvo-user-card .cvmax-ext-qasvo-user-avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.cvmax-ext-qasvo-user-name {
    font-size: 20px;
    font-weight: 600;
    color: #1A1A1A;
    margin: 0 0 4px 0;
}

.cvmax-ext-qasvo-user-email {
    font-size: 14px;
    color: #666;
    margin: 0 0 16px 0;
}

.cvmax-ext-qasvo-user-stats {
    display: flex;
    gap: 20px;
    justify-content: center;
}

.cvmax-ext-qasvo-stat-item {
    text-align: center;
}

.cvmax-ext-qasvo-stat-number {
    display: block;
    font-size: 18px;
    font-weight: 600;
    color: #6B4EFF;
    margin-bottom: 4px;
}

.cvmax-ext-qasvo-stat-label {
    font-size: 12px;
    color: #666;
}

/* 用户操作按钮 */
.cvmax-ext-qasvo-user-actions {
    display: flex;
    gap: 12px;
    justify-content: center;
}

.cvmax-ext-qasvo-action-button {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 16px;
    background: #F8F9FA;
    color: #495057;
    border: 1px solid #DEE2E6;
    border-radius: 8px;
    font-size: 13px;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.2s ease;
}

.cvmax-ext-qasvo-action-button:hover {
    background: #E9ECEF;
    border-color: #ADB5BD;
    color: #343A40;
}

.cvmax-ext-qasvo-action-button .cvmax-ext-qasvo-button-icon {
    font-size: 14px;
}

/*  */

/* 填充方式选择样式 */
.cvmax-ext-qasvo-fill-mode-section {
    padding: 16px 0;
}

.cvmax-ext-qasvo-fill-mode-options {
    display: flex;
    flex-direction: column;
    gap: 12px;
}

.cvmax-ext-qasvo-fill-mode-option {
    display: flex;
    align-items: center;
    padding: 16px;
    background: #FFFFFF;
    border: 2px solid #E5E7EB;
    border-radius: 12px;
    cursor: pointer;
    transition: all 0.2s ease;
    text-align: left;
    width: 100%;
    font-family: inherit;
}

.cvmax-ext-qasvo-fill-mode-option:hover {
    border-color: #7C3AED;
    background: #F8F6FF;
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(124, 58, 237, 0.15);
}

.cvmax-ext-qasvo-fill-mode-option:active {
    transform: translateY(0);
    box-shadow: 0 2px 6px rgba(124, 58, 237, 0.2);
}

.cvmax-ext-qasvo-fill-mode-option .cvmax-ext-qasvo-option-icon {
    font-size: 24px;
    margin-right: 16px;
    flex-shrink: 0;
}

.cvmax-ext-qasvo-fill-mode-option .cvmax-ext-qasvo-option-content {
    flex: 1;
}

.cvmax-ext-qasvo-fill-mode-option .cvmax-ext-qasvo-option-title {
    font-size: 16px;
    font-weight: 600;
    color: #1F2937;
    margin-bottom: 4px;
}

.cvmax-ext-qasvo-fill-mode-option .cvmax-ext-qasvo-option-desc {
    font-size: 14px;
    color: #6B7280;
    line-height: 1.4;
}

/* 专门样式 */
.cvmax-ext-qasvo-resume-upload-mode {
    border-color: #3B82F6;
}

.cvmax-ext-qasvo-resume-upload-mode:hover {
    border-color: #2563EB;
    background: #EFF6FF;
    box-shadow: 0 4px 12px rgba(59, 130, 246, 0.15);
}

.cvmax-ext-qasvo-direct-fill-mode {
    border-color: #10B981;
}

.cvmax-ext-qasvo-direct-fill-mode:hover {
    border-color: #059669;
    background: #ECFDF5;
    box-shadow: 0 4px 12px rgba(16, 185, 129, 0.15);
}

/* 上传简历选项样式 */
.cvmax-ext-qasvo-upload-resume-option {
    border: 1px solid rgba(242, 242, 242, 0.623529) !important;
    background: #ECE9FF !important;
}

.cvmax-ext-qasvo-upload-resume-option:hover {
    background: #E8E5FF !important;
    border-color: #D0C7FF !important;
    transform: translateY(-1px);
    box-shadow: 0 4px 8px rgba(106, 42, 255, 0.15);
}

.cvmax-ext-qasvo-upload-resume-option:active {
    transform: translateY(0);
    box-shadow: 0 2px 4px rgba(106, 42, 255, 0.2);
}

.cvmax-ext-qasvo-upload-info {
    display: flex;
    flex-direction: column;
    gap: 2px;
}

.cvmax-ext-qasvo-upload-subtitle {
    font-size: 12px;
    color: #6B7280;
    line-height: 1.3;
    margin-top: 2px;
}

.cvmax-ext-qasvo-upload-arrow {
    width: 20px;
    height: 20px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: rgba(107, 114, 128, 0.1);
    transition: all 0.2s ease;
}

.cvmax-ext-qasvo-upload-resume-option:hover .cvmax-ext-qasvo-upload-arrow {
    background: rgba(106, 42, 255, 0.2);
}

.cvmax-ext-qasvo-upload-resume-option:hover .cvmax-ext-qasvo-upload-arrow svg path {
    stroke: #6A2AFF;
}

/* 简历预览模态框样式 */
.cvmax-ext-qasvo-preview-modal {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.6);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 2147483647;
    animation: cvmax-ext-qasvo-fadeIn 0.2s ease;
}

@keyframes cvmax-ext-qasvo-fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
}

.cvmax-ext-qasvo-preview-modal-content {
    background: white;
    border-radius: 12px;
    width: 90%;
    max-width: 900px;
    height: 90%;
    max-height: 700px;
    display: flex;
    flex-direction: column;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.2);
    animation: cvmax-ext-qasvo-slideUp 0.3s ease;
}

@keyframes cvmax-ext-qasvo-slideUp {
    from { 
        opacity: 0;
        transform: translateY(20px);
    }
    to { 
        opacity: 1;
        transform: translateY(0);
    }
}

.cvmax-ext-qasvo-preview-modal-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 20px 24px;
    border-bottom: 1px solid #E5E7EB;
}

.cvmax-ext-qasvo-preview-modal-title {
    font-size: 16px;
    font-weight: 600;
    color: #1F2937;
    margin: 0;
}

.cvmax-ext-qasvo-preview-modal-close {
    width: 32px;
    height: 32px;
    border: none;
    background: transparent;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 6px;
    transition: background 0.2s ease;
}

.cvmax-ext-qasvo-preview-modal-close:hover {
    background: #F3F4F6;
}

.cvmax-ext-qasvo-preview-modal-body {
    flex: 1;
    padding: 0;
    overflow: hidden;
}

.cvmax-ext-qasvo-preview-iframe {
    width: 100%;
    height: 100%;
    border: none;
    border-radius: 0 0 12px 12px;
}

/* 分享弹窗样式 */
.cvmax-ext-qasvo-share-modal {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 2147483647;
    display: flex;
    align-items: center;
    justify-content: center;
}

.cvmax-ext-qasvo-share-modal-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.5);
}

.cvmax-ext-qasvo-share-modal-content {
    position: relative;
    width: 499px;
    height: 500px;
    background: white;
    box-shadow: 0px 3.2px 3.2px rgba(0, 0, 0, 0.06);
    border-radius: 16px;
    border: 0.8px solid rgba(245, 240, 255, 0.60);
    padding: 24px;
    display: flex;
    flex-direction: column;
    align-items: center;
    z-index: 1;
}

.cvmax-ext-qasvo-share-modal-close {
    position: absolute;
    top: 16px;
    right: 16px;
    width: 32px;
    height: 32px;
    border: none;
    background: transparent;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    transition: background 0.2s ease;
}

.cvmax-ext-qasvo-share-modal-close:hover {
    background: rgba(0, 0, 0, 0.05);
}

.cvmax-ext-qasvo-share-modal-title {
    color: black;
    font-size: 24px;
    font-family: Alibaba PuHuiTi 2.0, -apple-system, BlinkMacSystemFont, sans-serif;
    font-weight: 500;
    line-height: 24px;
    margin: 0 0 16px 0;
}

.cvmax-ext-qasvo-share-modal-desc {
    color: rgba(0, 0, 0, 0.85);
    font-size: 16px;
    font-family: Alibaba PuHuiTi 2.0, -apple-system, BlinkMacSystemFont, sans-serif;
    font-weight: 400;
    line-height: 24px;
    margin: 0 0 24px 0;
    text-align: center;
}

.cvmax-ext-qasvo-share-content-box {
    width: 451px;
    height: 214px;
    background: #F2F2F2;
    border-radius: 12px;
    padding: 24px;
    box-sizing: border-box;
    margin-bottom: 24px;
    overflow-y: auto;
}

.cvmax-ext-qasvo-share-text {
    color: rgba(0, 0, 0, 0.40);
    font-size: 16px;
    font-family: PingFang SC, -apple-system, BlinkMacSystemFont, sans-serif;
    font-weight: 500;
    line-height: 24px;
    margin: 0;
}

/* 排行榜样式 */
.cvmax-ext-qasvo-leaderboard-container {
    width: 100%;
    margin-bottom: 24px;
}

.cvmax-ext-qasvo-leaderboard {
    box-sizing: border-box;
    display: flex;
    width: 100%;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    border-radius: 8.7px;
    border: 0.7px solid rgba(242, 242, 242, 0.62);
    background: #ECE9FF;
    padding: 8px 12px;
    font-family: Alibaba PuHuiTi 2.0, -apple-system, BlinkMacSystemFont, sans-serif;
}

/* 排行榜表头 */
.cvmax-ext-qasvo-leaderboard-header {
    display: flex;
    height: 18px;
    width: 100%;
    align-items: center;
    font-size: 14px;
    font-weight: 400;
    color: rgba(0, 0, 0, 0.6);
}

.cvmax-ext-qasvo-leaderboard-rank-header {
    flex: 1;
    text-align: center;
}

.cvmax-ext-qasvo-leaderboard-user-header {
    flex: 1;
    text-align: center;
}

.cvmax-ext-qasvo-leaderboard-count-header {
    flex: 1;
    text-align: center;
}

.cvmax-ext-qasvo-leaderboard-bonus-header {
    flex: 1;
    text-align: center;
}

/* 排行榜数据行容器 */
.cvmax-ext-qasvo-leaderboard-body {
    display: flex;
    width: 100%;
    flex-direction: column;
    gap: 7.3px;
}

/* 排行榜数据行 */
.cvmax-ext-qasvo-leaderboard-item {
    display: flex;
    height: 36px;
    width: 100%;
    align-items: center;
    border-radius: 7.3px;
    background: white;
    padding: 4px 0;
}

.cvmax-ext-qasvo-leaderboard-rank {
    flex: 1;
    text-align: center;
    font-family: 'DIN Alternate', -apple-system, BlinkMacSystemFont, sans-serif;
    font-size: 14px;
    font-weight: bold;
}

.cvmax-ext-qasvo-leaderboard-user {
    flex: 1;
    text-align: center;
    font-size: 14px;
    color: rgba(0, 0, 0, 0.85);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.cvmax-ext-qasvo-leaderboard-count {
    flex: 1;
    text-align: center;
    font-family: 'DIN Alternate', -apple-system, BlinkMacSystemFont, sans-serif;
    font-size: 14px;
    font-style: italic;
    color: rgba(0, 0, 0, 0.85);
}

.cvmax-ext-qasvo-leaderboard-bonus {
    flex: 1;
    text-align: center;
    font-family: 'DIN Alternate', -apple-system, BlinkMacSystemFont, sans-serif;
    font-size: 14px;
    font-weight: bold;
    font-style: italic;
}


.cvmax-ext-qasvo-share-btn-container {
    display: flex;
    width: 75%;
    justify-content: space-between;
 }
 
 .cvmax-ext-qasvo-share-copy-btn-xiaohongshu {
